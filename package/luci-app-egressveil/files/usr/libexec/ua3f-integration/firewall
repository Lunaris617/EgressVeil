#!/bin/sh
# Runs on OpenWrt only. All nft changes in a reconciliation form one batch.
set -eu
. /etc/ua3f-integration.conf
fail() { echo "$*" >&2; exit 1; }
case "$LAN_IFACE:$WAN_IFACE" in *[!a-zA-Z0-9_.:-]*) fail 'Invalid interface';; esac
case "$STAGE" in management-only|udp|final-egress) ;; *) fail 'Invalid stage';; esac
root=/etc/ua3f-integration
mkdir -p "$root"
lock=/var/lock/ua3f-integration-firewall
attempt=0
until mkdir "$lock" 2>/dev/null; do
    owner=$(cat "$lock/owner" 2>/dev/null || :)
    case "$owner" in ''|*[!0-9]*) ;; *)
        if ! kill -0 "$owner" 2>/dev/null; then
            rm -f "$lock/owner"
            rmdir "$lock" 2>/dev/null || :
        fi;;
    esac
    attempt=$((attempt+1))
    [ "$attempt" -lt 10 ] || fail 'Firewall reconciliation lock timed out'
    sleep 1
done
printf '%s\n' "$$" > "$lock/owner"
tmp=$(mktemp /tmp/ua3fi-nft.XXXXXX)
trap 'rm -f "$tmp" "$lock/owner"; rmdir "$lock"' EXIT
trap 'exit 1' HUP INT TERM
off=0
check=0
case "${1:-}" in off) off=1;; reconcile) ;; check) check=1;; *) fail 'Usage: firewall reconcile|check|off';; esac
enabled=$(uci -q get ua3f.enabled.enabled || :)
# Enabled controls UA TCP rewriting. Committed UDP remains a Clash function.
if [ "$enabled" != 1 ] && [ "$STAGE" = final-egress ]; then STAGE=udp; fi

# Remove only our identifiable rules. Handles are read fresh every time.
for chain in input dstnat openclash openclash_output openclash_mangle openclash_mangle_output; do
    nft -a list chain inet fw4 "$chain" >/dev/null 2>&1 || continue
    nft -a list chain inet fw4 "$chain" | sed -n '/comment "ua3fi:/s/.*# handle \([0-9][0-9]*\).*/\1/p' |
    while read -r handle; do printf 'delete rule inet fw4 %s handle %s\n' "$chain" "$handle"; done >> "$tmp"
done
for chain in ua3fi_pre ua3fi_out; do
    if nft list chain inet fw4 "$chain" >/dev/null 2>&1; then
        printf 'flush chain inet fw4 %s\ndelete chain inet fw4 %s\n' "$chain" "$chain" >> "$tmp"
    fi
done

if [ "$off" = 1 ] || [ "$STAGE" = management-only ]; then
    # Restore the exact broad QUIC rules only if previously removed by us.
    if [ -f "$root/quic.restore" ]; then
        while IFS= read -r rule; do
            chain=$(printf '%s\n' "$rule" | awk '{print $5}')
            nft list chain inet fw4 "$chain" | grep -q 'comment "OpenClash QUIC REJECT"' || printf '%s\n' "$rule" >> "$tmp"
        done < "$root/quic.restore"
    fi
    nft -c -f "$tmp"
    [ "$check" = 0 ] || exit 0
    /usr/libexec/ua3f-integration/pre-clash off
    nft -f "$tmp"
    /usr/libexec/ua3f-integration/boot-guard off
    /usr/libexec/ua3f-integration/compat-delivery off
    /usr/libexec/ua3f-integration/dns-nat-guard off
    # Remove the persistent guard only on an explicit off/stage downgrade.
    if [ -f "$root/guard-owned" ] && nft list table inet ua3fi_guard >/dev/null 2>&1; then
        nft delete table inet ua3fi_guard
    fi
    if [ -f "$root/table458-owned" ]; then
        while ip -4 rule del pref 10458 fwmark 0x1cc/0xffffffff lookup 458 2>/dev/null; do :; done
        while ip -4 rule del pref 10459 fwmark 0x1cd/0xffffffff lookup 458 2>/dev/null; do :; done
        ip -4 route del local default dev lo table 458 2>/dev/null || :
    fi
    exit 0
fi

/usr/libexec/ua3f-integration/compat-delivery check
/usr/libexec/ua3f-integration/dns-nat-guard check

# Verify the fresh classifier still matches the implementation. Additional
# redirection forms need a reviewed classifier before final-egress activation.
for chain in openclash openclash_output openclash_mangle openclash_mangle_output; do
    nft list chain inet fw4 "$chain" >/dev/null || fail "Missing OpenClash chain $chain"
done
if [ "$STAGE" = final-egress ]; then
    shape=$(nft list chain inet fw4 openclash | sed '/ua3fi:/d')
    printf '%s\n' "$shape" | grep -q 'ip protocol tcp redirect to :7892' || fail 'Changed Clash TCP redirect'
    redirects=$(printf '%s\n' "$shape" | grep -c 'redirect to :7892' || :)
    [ "$redirects" = 2 ] || fail 'Unexpected additional Clash redirect'
    printf '%s\n' "$shape" | grep -F "$FAKEIP_CIDR" | grep -q 'redirect to :7892' || fail 'Changed fake-IP CIDR'
fi

case "$FAKEIP_CIDR" in *[!0-9./]*) fail 'Invalid fake-IP CIDR';; esac
lan_cidrs=$(ip -4 route show dev "$LAN_IFACE" scope link | awk '$1 ~ /^[0-9]/ {print $1}')
[ -n "$lan_cidrs" ] || fail 'No directly connected LAN route'
for cidr in $lan_cidrs $MANAGEMENT_CIDRS; do
    printf '%s\n' "$cidr" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$' || fail 'Invalid management/LAN destination'
done

# This independent table survives fw4's own table rebuild. It allows the
# working transparent paths, and blocks raw WAN fallthrough while fw4 or
# OpenClash is being rebuilt or the integration hook rejects an unknown shape.
guard_tmp=$(mktemp /tmp/ua3fi-guard.XXXXXX)
if nft list table inet ua3fi_guard >/dev/null 2>&1; then
    [ -f "$root/guard-owned" ] || fail 'Guard table name is already occupied'
    printf 'delete table inet ua3fi_guard\n' >> "$guard_tmp"
fi
cat >> "$guard_tmp" <<EOF
add table inet ua3fi_guard
add chain inet ua3fi_guard forward { type filter hook forward priority -10; policy accept; }
add rule inet ua3fi_guard forward meta nfproto != ipv4 return
add rule inet ua3fi_guard forward iifname != "$LAN_IFACE" return
add rule inet ua3fi_guard forward oifname != "$WAN_IFACE" return
add rule inet ua3fi_guard forward ip daddr { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 224.0.0.0/4, 240.0.0.0/4 } return
EOF
for cidr in $lan_cidrs $MANAGEMENT_CIDRS; do
    printf 'add rule inet ua3fi_guard forward ip daddr %s return\n' "$cidr" >> "$guard_tmp"
done
cat >> "$guard_tmp" <<EOF
add rule inet ua3fi_guard forward udp dport { 53, 67, 68, 123 } return
add rule inet ua3fi_guard forward meta l4proto udp counter drop
EOF
if [ "$STAGE" = final-egress ]; then
    cat >> "$guard_tmp" <<EOF
add rule inet ua3fi_guard forward meta l4proto tcp counter drop
# Chain name output is retained for status compatibility. POSTROUTING observes
# the rerouted skb_dst device; LOCAL_OUT meta oifname still sees old state.out.
add chain inet ua3fi_guard output { type filter hook postrouting priority 110; policy accept; }
add rule inet ua3fi_guard output meta nfproto != ipv4 return
add rule inet ua3fi_guard output oifname != "$WAN_IFACE" return
add rule inet ua3fi_guard output meta l4proto != tcp return
add rule inet ua3fi_guard output ct direction reply return
add rule inet ua3fi_guard output meta mark 0x1cb return
add rule inet ua3fi_guard output ip daddr { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 224.0.0.0/4, 240.0.0.0/4 } return
EOF
    for cidr in $lan_cidrs $MANAGEMENT_CIDRS; do
        printf 'add rule inet ua3fi_guard output ip daddr %s return\n' "$cidr" >> "$guard_tmp"
    done
    printf 'add rule inet ua3fi_guard output meta l4proto tcp counter drop\n' >> "$guard_tmp"
fi
nft -c -f "$guard_tmp"
if [ "$check" = 0 ]; then
    : > "$root/guard-owned"
    nft -f "$guard_tmp"
fi
rm -f "$guard_tmp"

# Refuse table or preference collisions before any route mutation.
if [ ! -f "$root/table458-owned" ]; then
    [ -z "$(ip -4 route show table 458 2>/dev/null)" ] || fail 'Policy table 458 is occupied'
    ! ip -4 rule show | grep -Eq '(^10458:|^10459:|fwmark 0x1cc|fwmark 0x1cd|lookup 458)' || fail 'Policy mark/preference collision'
    [ "$check" = 1 ] || : > "$root/table458-owned"
fi
if [ "$check" = 0 ]; then
    ip -4 route replace local default dev lo table 458
    ip -4 rule show | grep -q '^10458:.*fwmark 0x1cc.*lookup 458' || ip -4 rule add pref 10458 fwmark 0x1cc/0xffffffff lookup 458
    ip -4 rule show | grep -q '^10459:.*fwmark 0x1cd.*lookup 458' || ip -4 rule add pref 10459 fwmark 0x1cd/0xffffffff lookup 458
fi

# Legacy UA3F's own chain must not overwrite reinjected/final-direct marks.
# Exemptions in a separate base chain would NOT stop later hooks.
for chain in UA3F UA3F_OUTPUT; do
    [ "$enabled" = 1 ] || continue
    iptables -t mangle -S "$chain" >/dev/null || fail "Legacy chain $chain missing"
    for mark in 0x1ca 0x1cb 0x1cc; do
        [ "$check" = 0 ] || continue
        iptables -t mangle -C "$chain" -m mark --mark "$mark" -j RETURN 2>/dev/null || iptables -t mangle -I "$chain" 1 -m mark --mark "$mark" -j RETURN
    done
done
for chain in openclash openclash_output openclash_mangle openclash_mangle_output; do
    # Crucially, these RETURNs execute INSIDE actual OpenClash chains.
    printf 'insert rule inet fw4 %s meta mark { 0x1ca, 0x1cb, 0x1cc, 0x1cd } return comment "ua3fi:mark-guard"\n' "$chain" >> "$tmp"
done
printf 'insert rule inet fw4 input meta nfproto ipv4 meta mark { 0x1cc, 0x1cd } accept comment "ua3fi:transparent-input"\n' >> "$tmp"
if nft list chain inet fw4 dstnat >/dev/null 2>&1; then
    printf 'insert rule inet fw4 dstnat meta nfproto ipv4 meta l4proto tcp meta mark 0x1cc return comment "ua3fi:dns-exempt"\n' >> "$tmp"
    printf 'insert rule inet fw4 dstnat meta nfproto ipv4 meta l4proto tcp tcp dport != 53 meta mark 0x1ca return comment "ua3fi:dns-exempt"\n' >> "$tmp"
fi

# Snapshot broad rejects once; remove every current occurrence on reload.
quic_tmp=$(mktemp /tmp/ua3fi-quic.XXXXXX)
for chain in input forward; do
    nft -a list chain inet fw4 "$chain" | sed -n '/comment "OpenClash QUIC REJECT"/p' |
    while IFS= read -r line; do
        handle=$(printf '%s\n' "$line" | sed 's/.*# handle //')
        expr=$(printf '%s\n' "$line" | sed 's/^[[:space:]]*//;s/ # handle [0-9]*$//')
        printf 'insert rule inet fw4 %s %s\n' "$chain" "$expr" >> "$quic_tmp"
        printf 'delete rule inet fw4 %s handle %s\n' "$chain" "$handle" >> "$tmp"
    done
done
if [ "$check" = 0 ] && [ ! -f "$root/quic.restore" ]; then
    umask 077
    cp "$quic_tmp" "$root/quic.restore"
fi
rm -f "$quic_tmp"

cat >> "$tmp" <<EOF
add chain inet fw4 ua3fi_pre { type filter hook prerouting priority -149; policy accept; }
add rule inet fw4 ua3fi_pre meta nfproto != ipv4 return
add rule inet fw4 ua3fi_pre meta mark { 0x1ca, 0x1cb, 0xc9 } return
EOF
if [ "$STAGE" = final-egress ]; then
    printf 'add rule inet fw4 ua3fi_pre iifname "lo" meta l4proto tcp meta mark 0x1cc counter accept\n' >> "$tmp"
fi
cat >> "$tmp" <<EOF
add rule inet fw4 ua3fi_pre iifname != "$LAN_IFACE" return
add rule inet fw4 ua3fi_pre ct direction reply return
add rule inet fw4 ua3fi_pre fib daddr type { local, broadcast, multicast } return
add rule inet fw4 ua3fi_pre ip daddr { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 224.0.0.0/4, 240.0.0.0/4 } return
EOF
for cidr in $lan_cidrs $MANAGEMENT_CIDRS; do
    printf 'add rule inet fw4 ua3fi_pre ip daddr %s return\n' "$cidr" >> "$tmp"
done
cat >> "$tmp" <<EOF
add rule inet fw4 ua3fi_pre udp dport { 53, 67, 68, 123 } return
add rule inet fw4 ua3fi_pre meta l4proto udp meta mark set 0x1cd counter accept
EOF
if [ "$STAGE" = final-egress ]; then
    cat >> "$tmp" <<EOF
add rule inet fw4 ua3fi_pre meta l4proto != tcp return
# LAN TCP53 retains the existing later DNS REDIRECT; this is not a WAN bypass.
add rule inet fw4 ua3fi_pre tcp dport 53 return
add rule inet fw4 ua3fi_pre ip daddr $FAKEIP_CIDR return
add rule inet fw4 ua3fi_pre meta l4proto tcp ip daddr @localnetwork meta mark set 0x1cc counter accept
add rule inet fw4 ua3fi_pre meta l4proto tcp return
add chain inet fw4 ua3fi_out { type route hook output priority -149; policy accept; }
add rule inet fw4 ua3fi_out meta nfproto != ipv4 return
add rule inet fw4 ua3fi_out meta l4proto != tcp return
add rule inet fw4 ua3fi_out meta mark { 0xc9, 0x1ca, 0x1cb, 0x1cc } return
add rule inet fw4 ua3fi_out ct direction reply return
add rule inet fw4 ua3fi_out fib daddr type { local, broadcast, multicast } return
add rule inet fw4 ua3fi_out ip daddr { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 224.0.0.0/4, 240.0.0.0/4 } return
add rule inet fw4 ua3fi_out ip daddr $FAKEIP_CIDR return
EOF
    for cidr in $lan_cidrs $MANAGEMENT_CIDRS; do
        printf 'add rule inet fw4 ua3fi_out ip daddr %s return\n' "$cidr" >> "$tmp"
    done
    # No GID bypass: selected Clash TCP transports must reach the final core.
    printf 'add rule inet fw4 ua3fi_out oifname "%s" meta mark set 0x1cc counter\n' "$WAN_IFACE" >> "$tmp"
fi
nft -c -f "$tmp"
[ "$check" = 0 ] || exit 0
/usr/libexec/ua3f-integration/compat-delivery ensure
if [ "$STAGE" = final-egress ]; then
    # Must precede classifiers: a separate base-chain ACCEPT does not stop DNAT.
    /usr/libexec/ua3f-integration/dns-nat-guard ensure
fi
nft -f "$tmp"
if [ "$STAGE" = final-egress ]; then
    /usr/libexec/ua3f-integration/pre-clash ensure
else
    /usr/libexec/ua3f-integration/pre-clash off
fi
/usr/libexec/ua3f-integration/boot-guard off
if [ "$STAGE" != final-egress ]; then
    /usr/libexec/ua3f-integration/dns-nat-guard off
fi
