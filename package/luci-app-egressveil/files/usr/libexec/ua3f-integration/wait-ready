#!/bin/sh
# Bounded one-shot for explicit LuCI off -> on only; never a watchdog.
set -eu
. /etc/ua3f-integration.conf
attempt=0
limit=30
[ "${1:-}" != --check ] || limit=1
while [ "$attempt" -lt "$limit" ]; do
    [ "$(uci -q get ua3f.enabled.enabled)" = 1 ] || exit 0
    # start_service returns before procd publishes its new instance; no PID is
    # a retry condition rather than a set -e failure.
    pid=$(ubus call service list '{"name":"ua3f"}' | jsonfilter -e '@.ua3f.instances.ua3f.pid' || :)
    case "$pid" in ''|*[!0-9]*) ;; *)
        ready=1
        for port in 0438 0439; do
            inode=$(awk -v port="$port" '$2 ~ ":" port "$" && $4 == "0A" {print $10;exit}' /proc/net/tcp /proc/net/tcp6)
            if [ -z "$inode" ]; then ready=0; break; fi
            found=0
            for fd in "/proc/$pid/fd/"*; do
                [ "$(readlink "$fd" 2>/dev/null || :)" != "socket:[$inode]" ] || { found=1; break; }
            done
            [ "$found" = 1 ] || { ready=0; break; }
        done
        if [ "$ready" = 1 ]; then
            iptables -t nat -C OUTPUT -p tcp -m mark --mark 0xc9 -j REDIRECT --to-ports 7892 >/dev/null 2>&1 || ready=0
            iptables -t mangle -C PREROUTING -p tcp -j UA3F >/dev/null 2>&1 || ready=0
            case "$STAGE" in udp|final-egress)
                /usr/libexec/ua3f-integration/compat-delivery ready >/dev/null 2>&1 || ready=0
                nft list chain inet fw4 ua3fi_pre >/dev/null 2>&1 || ready=0
                nft list table inet ua3fi_guard >/dev/null 2>&1 || ready=0
            ;; esac
            if [ "$STAGE" = final-egress ]; then
                /usr/libexec/ua3f-integration/pre-clash ready >/dev/null 2>&1 || ready=0
                /usr/libexec/ua3f-integration/dns-nat-guard ready >/dev/null 2>&1 || ready=0
                nft list chain inet fw4 ua3fi_out >/dev/null 2>&1 || ready=0
                nft list chain inet fw4 openclash | grep -q 'ua3fi:mark-guard' || ready=0
            fi
        fi
        # ua3fi_v9: verify both paths before releasing the explicit enable barrier.
        /usr/libexec/ua3f-bridge-policy/bridge-policy ready >/dev/null 2>&1 || ready=0
        if [ "$(uci -q get egressveil.main.ttl_enabled)" = 1 ]; then
          /usr/libexec/ua3f-integration/ttl-policy check >/dev/null 2>&1 || ready=0
        fi
        if [ "$ready" = 1 ]; then
            if [ "$(uci -q get egressveil.main.ttl_enabled)" = 1 ]; then
             ttl=$(uci -q get egressveil.main.ttl)
             nft list chain netdev ua3fi_ttl_last egress | grep -q "ip ttl set $ttl " || exit 1
            fi
            /usr/libexec/ua3f-integration/firewall check
            [ "${1:-}" != --check ] || exit 0
            exec /usr/libexec/ua3f-integration/runtime unprotect
        fi
    ;; esac
    attempt=$((attempt + 1))
    sleep 1
done
logger -t ua3f-integration 'LuCI enable did not become ready; migration barrier remains'
exit 1
