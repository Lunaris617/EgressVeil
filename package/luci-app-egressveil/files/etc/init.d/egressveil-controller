#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=09
start_service() {
 [ -f /etc/egressveil/activated ] || [ -f /var/run/egressveil.pending ] || return 0
 . /lib/functions/network.sh
 network_get_ipaddr lan_ip "$(uci -q get egressveil.main.lan || echo lan)" || return 1
 case "$lan_ip" in ''|*[!0-9.]*) return 1;; esac
 procd_open_instance gateway
 procd_set_param command /usr/libexec/egressveil/controller "$lan_ip:9090"
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 0
 procd_set_param stderr 0
 procd_close_instance
}
service_triggers() { procd_add_reload_trigger egressveil; }
