#!/bin/sh /etc/rc.common
# Independent early fail-closed native IPv4 TCP guard.
START=17
STOP=01
POLICY=/usr/libexec/ua3f-integration/ttl-policy
start() {
    [ -f /etc/egressveil/activated ] || [ -f /var/run/egressveil.pending ] || return 0
    "$POLICY" barrier || return 1
    "$POLICY" apply
}
boot() { start; }
reload() { start; }
# Keep the empty native TCP gate during service stop/shutdown. Explicit reviewed
# uninstall uses ttl-policy remove; it never restores the feature automatically.
stop() { "$POLICY" barrier; }
